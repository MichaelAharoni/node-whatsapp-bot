{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "target": "ES6",
    "moduleResolution": "node",
    "sourceMap": true,
    "outDir": "./dist",
    "strict": true,
    "skipLibCheck": true,
  },
  "lib": ["es2015"],
  "include": ["lib/**/*.ts", "app.ts"],
  "exclude": ["node_modules"]
}